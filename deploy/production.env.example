# Template only. Do not put key material, credentials, or patient information here.
# This build intentionally blocks clinical production even with completed evidence.
CEVRALI_MODE=production
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://your-practice.example
CEVRALI_PUBLIC_SIGNUP=false
DATABASE_PATH=/var/lib/cevrali/cevrali.sqlite
ACCOUNTS_PATH=/var/lib/cevrali/accounts
# Mount two independently generated 32-byte Base64 keys as private 0400/0600 files.
CEVRALI_AUTH_ENCRYPTION_KEY_FILE=/run/secrets/cevrali-auth-key
CEVRALI_BACKUP_KEY_FILE=/run/secrets/cevrali-backup-key
# Supply the reviewed release revision and evidence; never invent approvals.
CEVRALI_RELEASE_COMMIT=
CEVRALI_PRODUCTION_RELEASE_FILE=/run/config/cevrali-release-evidence.json
