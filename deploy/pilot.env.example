# Synthetic staff pilot only. Provision a separate empty data directory.
# Terminate HTTPS at the trusted hosting proxy; mount private files for node UID.
CEVRALI_MODE=pilot
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://pilot.your-practice.example
CEVRALI_PUBLIC_SIGNUP=false
DATABASE_PATH=/var/lib/cevrali/cevrali.sqlite
ACCOUNTS_PATH=/var/lib/cevrali/accounts
CEVRALI_AUTH_ENCRYPTION_KEY_FILE=/run/secrets/cevrali-auth-key
CEVRALI_BACKUP_KEY_FILE=/run/secrets/cevrali-backup-key
