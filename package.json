{
  "name": "cevrali-ehr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && node scripts/copy-rfa-assets.mjs && vite build",
    "build:preview": "node --import tsx scripts/build-preview.mjs",
    "start": "node dist-server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:preview": "npm run build:preview && node --import tsx --test tests/preview.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "readiness": "node scripts/readiness.mjs",
    "init:pilot": "node scripts/init-pilot.mjs",
    "bootstrap:practice": "node scripts/bootstrap-practice.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "audit:verify": "node scripts/audit-verify.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.9.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
